# 바인드 주소와 경로를 지정합니다. 실제 설정·인증 값은 레포 밖의 파일에 보관하세요.
# 대시보드를 바인드할 Tailscale IP (예: tailscale ip -4 결과). 0.0.0.0 금지.
HOST=<tailscale-ip>
TOSS_ENV_PATH=~/invest/.toss.env
TOSS_TOKEN_PATH=~/invest/.token.json
TOSS_ACCOUNT_PATH=~/invest/account.json
PORTFOLIO_LEDGER_PATH=~/invest/portfolio.jsonl
# Proxy preview: 기존 대시보드 원점. TOSS_MOCK=1과 함께 사용하지 않습니다.
# UPSTREAM_URL=http://<upstream-host>:8790
